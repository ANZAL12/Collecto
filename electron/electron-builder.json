{
  "appId": "com.collecto.admin",
  "productName": "Collecto Admin",
  "copyright": "Copyright © 2026 Collecto",
  "electronVersion": "44.3.0",
  "compression": "maximum",
  "directories": {
    "output": "../release"
  },
  "asar": true,
  "files": [
    "main.js",
    "preload.js",
    "config.json",
    "favicon.ico"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "favicon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Collecto Admin"
  }
}
